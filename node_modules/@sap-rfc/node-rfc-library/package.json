{
  "author": "SAP SE (https://www.sap.com)",
  "description": "",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "copy-webpack-plugin": "^9.0.0",
    "eslint": "8.57.0",
    "eslint-plugin-sonarjs": "0.25.1",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.0",
    "prebuildify": "^6.0.1",
    "ts-jest": "^29.2.4",
    "ts-loader": "^9.5.1",
    "typescript": "^5.4.5",
    "typescript-declaration-webpack-plugin": "^0.3.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "files": [
    "dist",
    "LICENSE",
    "package.json"
  ],
  "license": "SEE LICENSE",
  "main": "dist/bundle",
  "name": "@sap-rfc/node-rfc-library",
  "scripts": {
    "build": "npm run build:addon && npm run build:api",
    "build:addon": "prebuildify --napi --force --verbose",
    "build:api": "npm run lint && webpack --config webpack/webpack.prod.js",
    "builddev": "npm run builddev:addon && npm run builddev:api",
    "builddev:addon": "prebuildify --napi --force --verbose --debug && node renameTestLib.js testdev",
    "builddev:api": "webpack --config webpack/webpack.dev.js",
    "install": "echo",
    "lint": "eslint src/api/**",
    "lint-fix": "eslint src/api/** --fix",
    "package": "npm run build && npm run test && npm pack",
    "test": "npm run test:api && npm run test:addon",
    "test:addon": "node renameTestLib.js && node tests/addon/test.js",
    "test:api": "jest",
    "test:integration": "jest --config=jest.integration.config.js",
    "testdev:addon": "node tests/addon/test.js testdev && sh cpp_coverage.sh"
  },
  "types": "dist/declarations",
  "version": "1.1.2"
}